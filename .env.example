# Copy this file to .env and fill in the values. .env is gitignored.

# Model the agent uses. Read from here, never hardcoded.
# With Ollama this is a local model name, pulled with `ollama pull`.
WHYRED_MODEL=qwen3:8b

# The Anthropic SDK reads these two. They point it at a local Ollama
# server, which speaks the Anthropic Messages API. Ollama ignores the
# key, but the SDK requires one to be set.
# To use the real Claude API instead, remove ANTHROPIC_BASE_URL, set a
# real key, and set WHYRED_MODEL to a Claude model.
ANTHROPIC_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=ollama

# GitHub token used to read workflow runs, logs, and diffs.
# A fine-grained token with read-only access to Actions, Contents,
# and Pull requests is enough for phase 1.
GITHUB_TOKEN=
