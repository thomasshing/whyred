# Copy this file to .env and fill in the values. .env is gitignored.

# Claude model the agent uses. Read from here, never hardcoded.
WHYRED_MODEL=claude-opus-5-5

# Anthropic API key, from https://console.anthropic.com
ANTHROPIC_API_KEY=

# GitHub token used to read workflow runs, logs, and diffs.
# A fine-grained token with read-only access to Actions, Contents,
# and Pull requests is enough for phase 1.
GITHUB_TOKEN=
